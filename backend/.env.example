# Local development only. Production uses Render environment variables.
GEMINI_API_KEY=replace_with_your_existing_key
GEMINI_MODEL=gemini-3.5-flash-lite
# ADVENTURE_DATA_DIR=E:/English-AI-Adventure/backend/data
# ADVENTURE_ENV=local
# Production: see docs/DEPLOYMENT.md, never put secrets in VITE_* variables.

# Staged cloud configuration: do not activate before an approved, verified migration.
ADVENTURE_CLOUD_ENABLE=no
ADVENTURE_DATABASE_BACKEND=sqlite
ADVENTURE_STORAGE_BACKEND=local
DATABASE_URL=[NEON_POOLED_POSTGRES_URL]
DATABASE_DIRECT_URL=[NEON_DIRECT_POSTGRES_URL]
ADVENTURE_PG_SCHEMA=english_ai_v1
PGSSLMODE=require
AWS_ACCESS_KEY_ID=[NEON_S3_ACCESS_KEY]
AWS_SECRET_ACCESS_KEY=[NEON_S3_SECRET_KEY]
AWS_SESSION_TOKEN=
AWS_REGION=us-east-2
S3_BUCKET=english-ai-files
S3_ENDPOINT_URL=[NEON_BRANCH_HTTPS_S3_ENDPOINT]
S3_PREFIX=[NEW_EMPTY_MIGRATION_NAMESPACE]
ADVENTURE_ALLOW_MIGRATION=no
